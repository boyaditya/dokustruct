# Dependencies
node_modules/

# Build output
dist/
build/

# Environment
.env
.env.*

# Model binaries (downloaded at runtime, never committed)
*.onnx
*.pth
*.onnx_data
public/models/
models/

# Benchmark run artifacts (generated results, not source)
benchmark/*.xlsx
!benchmark/examples/*.xlsx
benchmark/try/
benchmark/diffs/
benchmark/sample/
benchmark/pilot*/
benchmark/omnidocbench_gt/
benchmark/js_results/*
benchmark/py_results/*
benchmark/js_accuracy/
benchmark/js_pilot/
benchmark/js_timing/
benchmark/py_accuracy/
benchmark/py_pilot/
benchmark/py_timing/
!benchmark/js_results/.gitkeep
!benchmark/py_results/.gitkeep
benchmark/inputs/*
!benchmark/inputs/.gitkeep


# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp

# Vercel
.vercel/

# Agent/IDE local config
.commandcode/

# Python cache
__pycache__/

# Vitest coverage
coverage/

